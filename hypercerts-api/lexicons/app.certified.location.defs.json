{
  "lexicon": 1,
  "id": "app.certified.location.defs",
  "description": "Shared views for the HappyView location read API.",
  "defs": {
    "profileView": {
      "type": "object",
      "description": "Profile record view preserving the full indexed record.",
      "required": ["uri", "cid", "did", "indexedAt", "record"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "did": { "type": "string", "format": "did" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "record": { "type": "ref", "ref": "app.certified.actor.profile" }
      }
    },
    "organizationView": {
      "type": "object",
      "description": "Raw organization sidecar view preserving the full indexed record.",
      "required": ["uri", "cid", "did", "indexedAt", "record"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "did": { "type": "string", "format": "did" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "record": { "type": "ref", "ref": "app.certified.actor.organization" }
      }
    },
    "authorView": {
      "type": "object",
      "description": "Publishing DID with nullable profile and raw organization sidecar views.",
      "required": ["did", "profile", "organization"],
      "nullable": ["profile", "organization"],
      "properties": {
        "did": { "type": "string", "format": "did" },
        "profile": { "type": "ref", "ref": "#profileView" },
        "organization": { "type": "ref", "ref": "#organizationView" }
      }
    },
    "locationView": {
      "type": "object",
      "description": "Location record with full indexed metadata, original payload, and hydrated author.",
      "required": ["uri", "cid", "did", "indexedAt", "author", "record"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "did": { "type": "string", "format": "did" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "author": { "type": "ref", "ref": "#authorView" },
        "record": { "type": "ref", "ref": "app.certified.location" }
      }
    }
  }
}
